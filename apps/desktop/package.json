{
  "name": "@koliwada/desktop",
    "version": "0.1.5",
  "private": true,
  "main": "main.cjs",
  "description": "Koli Wada Dhaba restaurant POS",
  "author": "Koli Wada Dhaba",
  "scripts": {
    "dist:windows": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "in.koliwadadhaba.pos",
    "productName": "Koli Wada Dhaba POS",
    "directories": {
      "output": "../../release/windows-0.1.5"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "maintenance-contract.cjs",
      "print-contract.cjs",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "../../build-runtime/api",
        "to": "api",
        "filter": [
          "dist/**/*",
          "prisma/**/*",
          "package.json",
          "prisma.config.ts"
        ]
      },
      {
        "from": "../../build-runtime/api/node_modules",
        "to": "api/node_modules"
      },
      {
        "from": "../../build-runtime/postgresql17",
        "to": "postgresql17",
        "filter": [
          "bin/**/*",
          "lib/**/*",
          "share/**/*",
          "*license*.txt"
        ]
      },
      {
        "from": "../../build-runtime/installer-tools/node_modules",
        "to": "installer-tools/node_modules"
      },
      {
        "from": "../../build-runtime/installer",
        "to": "installer"
      },
      {
        "from": "../../build-runtime/shared",
        "to": "shared"
      }
    ],
    "compression": "normal",
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "include": "installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
