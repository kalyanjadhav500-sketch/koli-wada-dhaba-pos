# Local development example only. The installed Windows POS uses protected
# machine configuration and never reads this file.
DATABASE_URL=

# Optional local development URL for Prisma migrate.
DIRECT_URL=

# Use a private random value locally. Never commit a real secret.
JWT_SECRET=

NODE_ENV=development
PORT=4000
API_HOST=127.0.0.1
DB_POOL_MAX=5
TRUST_PROXY_HOPS=0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,koliwada://desktop
