# Runtime connection (use Neon pooled connection string for the API).
# The production connection string must include sslmode=require.
DATABASE_URL=

# Direct Neon connection for Prisma migrations and database administration.
# If unset, Prisma falls back to DATABASE_URL.
DIRECT_URL=

# Generate a unique random value of at least 32 characters; never commit it.
JWT_SECRET=

NODE_ENV=production
PORT=10000
API_HOST=0.0.0.0
DB_POOL_MAX=5
TRUST_PROXY_HOPS=1
CORS_ORIGINS=https://localhost,capacitor://localhost,koliwada://desktop

# Optional Owner password-recovery email; configure privately in the host dashboard.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
